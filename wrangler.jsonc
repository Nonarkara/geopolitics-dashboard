{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geopolitics-dashboard",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "geo.nonarkara.org",
      "custom_domain": true
    }
  ],
  "vars": {
    "APP_RUNTIME": "cloudflare-workers",
    "NEXT_PUBLIC_SUPABASE_URL": "https://qbatksnulitgrhigzbta.supabase.co"
  }
}
