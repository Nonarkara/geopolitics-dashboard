{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geopolitics-dashboard",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  // geo.nonarkara.org custom domain: blocked by an existing externally
  // managed DNS record (the 302-redirect). Delete that DNS record in the
  // nonarkara.org zone, then restore:
  // "routes": [{ "pattern": "geo.nonarkara.org", "custom_domain": true }],
  "vars": {
    "APP_RUNTIME": "cloudflare-workers",
    "NEXT_PUBLIC_SUPABASE_URL": "https://qbatksnulitgrhigzbta.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFiYXRrc251bGl0Z3JoaWd6YnRhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzQ0NjQ1NzEsImV4cCI6MjA5MDA0MDU3MX0.U9VJQoOtSvnvvB325zTwhO8KV0GPXX9qEl8CmMhrUug"
  }
}
