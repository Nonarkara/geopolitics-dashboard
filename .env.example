# ═══════════════════════════════════════════════════════
# Supabase (Primary database — single source of truth)
# ═══════════════════════════════════════════════════════

# Direct connection for raw SQL queries (PostGIS, window functions, migrations)
# Get this from: Supabase Dashboard → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Supabase API (for PostgREST client and Realtime subscriptions)
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ═══════════════════════════════════════════════════════
# Redis (Optional cache layer)
# ═══════════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379/0

# ═══════════════════════════════════════════════════════
# API Keys (Required for live data)
# ═══════════════════════════════════════════════════════

# Get your Mapbox token at https://www.mapbox.com/
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# Get your NASA FIRMS key at https://firms.modaps.eosdis.nasa.gov/api/config/realtime/
FIRMS_KEY=your_firms_key_here

# ACLED uses OAuth password login for API access via myACLED.
ACLED_USERNAME=
ACLED_PASSWORD=
ACLED_EMAIL=
ACLED_KEY=

# Get your OpenAI key at https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ═══════════════════════════════════════════════════════
# External Intelligence Feeds (Optional)
# ═══════════════════════════════════════════════════════
REFERENCE_DASHBOARD_URL=https://geopolitics-dashboard.vercel.app

# ═══════════════════════════════════════════════════════
# Security / Admin surfaces (Optional, disabled by default)
# ═══════════════════════════════════════════════════════

# Set both flags to true only if you explicitly want the browser-facing
# database explorer/export tools exposed in the UI and on the server.
NEXT_PUBLIC_ENABLE_DATA_EXPLORER=false
DATA_EXPLORER_ENABLED=false

# If you enable the data explorer, protect it with a bearer token.
DATA_EXPLORER_TOKEN=replace_with_a_long_random_token

# Vercel Cron bearer secret. Required in production if you enable the
# grouped `/api/cron/*` refresh routes.
CRON_SECRET=replace_with_a_long_random_secret

# ═══════════════════════════════════════════════════════
# Ingestion safety
# ═══════════════════════════════════════════════════════
ALLOW_MOCK_INGESTION=false
INGEST_REQUEST_TIMEOUT_SECONDS=30
