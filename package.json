{
  "name": "geopolitics-dashboard",
  "version": "6.0.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "build:static": "mv src/app/api /tmp/geo-api-backup && mv src/app/briefing /tmp/geo-briefing-backup 2>/dev/null; NEXT_OUTPUT=export NEXT_PUBLIC_STATIC_EXPORT=true next build --webpack; mv /tmp/geo-api-backup src/app/api; mv /tmp/geo-briefing-backup src/app/briefing 2>/dev/null; true",
    "build:worker": "opennextjs-cloudflare build",
    "preview:worker": "opennextjs-cloudflare preview",
    "deploy:static": "wrangler pages deploy out --project-name geopolitics-dashboard --branch main --commit-dirty=true",
    "deploy": "opennextjs-cloudflare deploy",
    "test:backend": "tsx --test tests/playback-backend.test.mts",
    "test:ui": "playwright test",
    "ingest:all": "python3 ingestion/run_all.py",
    "ingest:list": "python3 ingestion/run_all.py --list",
    "db:schema": "node scripts/apply-schema.mjs",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "db:migrate:status": "node scripts/apply-migrations.mjs --status",
    "db:summary": "python3 ingestion/build_daily_summary.py",
    "bootstrap:production": "bash scripts/bootstrap-production.sh"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.3.6",
    "@deck.gl/core": "^9.3.6",
    "@deck.gl/geo-layers": "^9.3.6",
    "@deck.gl/layers": "^9.3.6",
    "@deck.gl/mapbox": "^9.3.6",
    "@deck.gl/react": "^9.3.6",
    "@luma.gl/core": "^9.3.6",
    "@luma.gl/engine": "^9.3.6",
    "@luma.gl/webgl": "^9.3.6",
    "@supabase/supabase-js": "^2.110.0",
    "@tailwindcss/postcss": "^4.2.1",
    "axios": "^1.18.1",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "deck.gl": "^9.3.6",
    "framer-motion": "^12.35.2",
    "lucide-react": "^0.577.0",
    "mapbox-gl": "^3.25.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.2.1",
    "pg": "^8.20.0",
    "postcss": "^8.5.8",
    "react": "19.2.3",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.3",
    "react-map-gl": "^8.1.0",
    "redis": "^5.11.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.1",
    "@playwright/test": "^1.58.2",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "overrides": {
    "fast-xml-parser": "5.5.9",
    "flatted": "3.4.2"
  }
}
